{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppc.local/schemas/scenario_case.schema.json",
  "title": "PPC ScenarioCase",
  "description": "Pinned golden enterprise scenario manifest governing Scenario A (UC-1/UC-3), Scenario B (UC-2), and Scenario C (UC-5) runs, replays, and adverse batteries (PPC-SCENARIO-001 §1, ADR-0049).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_version",
    "use_case_ids",
    "lifecycle_status",
    "world_version",
    "branch_id",
    "parent_checkpoint_id",
    "logical_clock",
    "public_source_vintage",
    "model_pin",
    "upstream_contract_pins",
    "evidence_cutoff",
    "query_channel",
    "query_purpose",
    "allowed_roles",
    "expected_source_records",
    "failure_injections",
    "interventions",
    "expected_release_ids",
    "oracle_version",
    "access_policy",
    "provenance_class"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "case_id": { "type": "string", "minLength": 1 },
    "case_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "use_case_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["UC-1", "UC-2", "UC-3", "UC-4", "UC-5", "UC-6"] }
    },
    "lifecycle_status": { "type": "string", "enum": ["DRAFT", "REVIEWED", "FROZEN"] },
    "world_version": { "type": "string", "minLength": 1 },
    "branch_id": { "type": "string", "minLength": 1 },
    "parent_checkpoint_id": { "type": ["string", "null"], "minLength": 1 },
    "logical_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_utc", "horizon_end_utc", "process_step_seconds", "site_timezone"],
      "properties": {
        "origin_utc": { "type": "string", "format": "date-time" },
        "horizon_end_utc": { "type": "string", "format": "date-time" },
        "process_step_seconds": { "type": "integer", "const": 60 },
        "site_timezone": { "type": "string", "const": "America/Chicago" }
      }
    },
    "public_source_vintage": { "type": "string", "minLength": 1 },
    "model_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_release_id", "equation_set_version"],
      "properties": {
        "model_release_id": { "type": "string", "minLength": 1 },
        "equation_set_version": { "type": "string", "minLength": 1 }
      }
    },
    "upstream_contract_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epm", "ice", "edi", "ece"],
      "properties": {
        "epm": { "type": "string", "minLength": 1 },
        "ice": { "type": "string", "minLength": 1 },
        "edi": { "type": "string", "minLength": 1 },
        "ece": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_cutoff": { "type": "string", "format": "date-time" },
    "query_channel": { "type": "string", "minLength": 1 },
    "query_purpose": { "type": "string", "minLength": 1 },
    "allowed_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_source_records": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "failure_injections": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intervention_id", "effective_at", "description", "provenance_class"],
        "properties": {
          "intervention_id": { "type": "string", "minLength": 1 },
          "effective_at": { "type": "string", "format": "date-time" },
          "description": { "type": "string", "minLength": 1 },
          "provenance_class": { "type": "string", "const": "SCENARIO_ASSUMPTION" }
        }
      }
    },
    "expected_release_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "oracle_version": { "type": "string", "minLength": 1 },
    "access_policy": { "type": "string", "minLength": 1 },
    "provenance_class": {
      "type": "string",
      "enum": ["SYNTHETIC", "SCENARIO_ASSUMPTION"]
    }
  }
}
