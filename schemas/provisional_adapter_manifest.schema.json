{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppc.local/schemas/provisional_adapter_manifest.schema.json",
  "title": "PPC ProvisionalAdapterManifest",
  "description": "Versioned upstream boundary adapter manifest pinning an exact upstream repository commit while explicitly recording unapproved/pending upstream release status (ADR-0042, PPC-ARCH-000 §8.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "upstream_short_name",
    "upstream_repo_slug",
    "upstream_repo_url",
    "pinned_commit",
    "pinned_commit_date",
    "aligned_main_commit",
    "maturity_status",
    "approved_upstream_release",
    "pending_upstream_dependencies",
    "qualification_cap",
    "consumed_artifacts",
    "ppc_owner_boundary",
    "provenance_class"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "adapter_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "upstream_short_name": { "type": "string", "enum": ["EPM", "ICE", "EDI", "ECE"] },
    "upstream_repo_slug": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "former_repo_slug": { "type": ["string", "null"] },
    "upstream_repo_url": { "type": "string", "format": "uri" },
    "pinned_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pinned_commit_date": { "type": "string", "format": "date-time" },
    "aligned_main_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "maturity_status": {
      "type": "string",
      "enum": ["PROVISIONAL_COMMIT_PIN", "APPROVED_UPSTREAM_RELEASE"]
    },
    "approved_upstream_release": { "type": ["string", "null"] },
    "pending_upstream_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "qualification_cap": {
      "type": "string",
      "enum": ["QUALIFIED_PROVISIONAL", "QUALIFIED"]
    },
    "consumed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "upstream_path", "contract_role", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "upstream_path": { "type": "string", "minLength": 1 },
          "contract_role": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["CONSUMED_PROVISIONAL", "PENDING_UPSTREAM_RELEASE", "APPROVED_RELEASE"]
          }
        }
      }
    },
    "ppc_owner_boundary": { "type": "string", "minLength": 1 },
    "provenance_class": { "type": "string", "enum": ["OBSERVED", "SYNTHETIC"] }
  },
  "allOf": [
    {
      "if": { "properties": { "maturity_status": { "const": "PROVISIONAL_COMMIT_PIN" } } },
      "then": {
        "properties": {
          "approved_upstream_release": { "type": "null" },
          "qualification_cap": { "const": "QUALIFIED_PROVISIONAL" }
        }
      }
    }
  ]
}
