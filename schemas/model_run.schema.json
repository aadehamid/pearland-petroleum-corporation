{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppc.local/schemas/model_run.schema.json",
  "title": "PPC ModelRun",
  "description": "Typed numerical, optimization, forecasting, causal, or backcasting model run contract with pinned inputs, solver profile, tolerances, feasibility, and provenance (PPC-ANALYTICS-001 §1, ADR-0048, ADR-0056).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "method_class",
    "model_digest",
    "formula_digest",
    "parameter_digest",
    "branch_id",
    "subject_scope",
    "actor_id",
    "actor_role",
    "channel",
    "purpose",
    "access_scope",
    "effective_at",
    "knowledge_cutoff",
    "world_version",
    "product_release_id",
    "horizon",
    "grain",
    "units",
    "measurement_basis",
    "input_digest",
    "input_provenance",
    "output_provenance_class",
    "epistemic_status",
    "lifecycle_status",
    "released_at",
    "seed",
    "solver_configuration",
    "feasibility_status",
    "uncertainty_representation",
    "output_digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "method_class": {
      "type": "string",
      "enum": ["PLANNING_LP", "NONLINEAR_NLP", "BACKCASTING", "FORECASTING", "CAUSAL_ESTIMATION", "PROBABILISTIC", "PROCESS_DIAGNOSIS"]
    },
    "model_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "formula_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parameter_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "branch_id": { "type": "string", "minLength": 1 },
    "subject_scope": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "actor_role": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "access_scope": { "type": "string", "minLength": 1 },
    "effective_at": { "type": "string", "format": "date-time" },
    "knowledge_cutoff": { "type": "string", "format": "date-time" },
    "world_version": { "type": "string", "minLength": 1 },
    "product_release_id": { "type": "string", "minLength": 1 },
    "horizon": { "type": "string", "minLength": 1 },
    "grain": { "type": "string", "minLength": 1 },
    "units": { "type": "string", "minLength": 1 },
    "measurement_basis": { "type": "string", "minLength": 1 },
    "input_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["OBSERVED", "DERIVED", "ESTIMATED", "SYNTHETIC", "SCENARIO_ASSUMPTION"]
      }
    },
    "output_provenance_class": {
      "type": "string",
      "enum": ["OBSERVED", "DERIVED", "ESTIMATED", "SYNTHETIC", "SCENARIO_ASSUMPTION"]
    },
    "epistemic_status": {
      "type": "string",
      "enum": ["EVIDENCE", "INFERENCE", "CONTRADICTION", "UNKNOWN"]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "RELEASED", "SUPERSEDED", "FAILED", "OUT_OF_ENVELOPE", "INFEASIBLE"]
    },
    "released_at": { "type": ["string", "null"], "format": "date-time" },
    "seed": { "type": "integer", "minimum": 0 },
    "solver_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solver_name", "solver_version", "feasibility_tolerance"],
      "properties": {
        "solver_name": { "type": "string", "minLength": 1 },
        "solver_version": { "type": "string", "minLength": 1 },
        "feasibility_tolerance": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "feasibility_status": {
      "type": "string",
      "enum": ["FEASIBLE", "INFEASIBLE", "OUT_OF_ENVELOPE", "UNBOUNDED", "ERROR"]
    },
    "binding_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "uncertainty_representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["DETERMINISTIC", "INTERVAL", "QUANTILES", "POSTERIOR_SAMPLES"] },
        "lower_bound": { "type": ["number", "null"] },
        "upper_bound": { "type": ["number", "null"] },
        "confidence_level": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "output_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  }
}
