# PPC Local Development Environment Example (non-secret placeholders only)
# Copy to infra/.env for local Docker Compose parity runs. Never commit infra/.env.
# Operational and hidden-truth R2 credentials live outside Git in separate files
# (~/.config/ppc/r2-standard.env and ~/.config/ppc/r2-hidden.env; ADR-0057).

PPC_POSTGRES_USER=ppc_dev
PPC_POSTGRES_PASSWORD=ppc_dev_change_me
PPC_POSTGRES_DB=ppc

PPC_MYSQL_ROOT_PASSWORD=ppc_mysql_root_change_me
PPC_MYSQL_USER=ppc_logistics
PPC_MYSQL_PASSWORD=ppc_logistics_change_me
PPC_MYSQL_DATABASE=logistics

PPC_NEO4J_AUTH=neo4j/ppc_neo4j_change_me
